        Name = title,
        Content = content,
        Image = "rbxassetid://4483345998",
        Time = time or 2
    })
end

-- Hiển thị thông báo chào mừng tác giả khi mở script
Notify("Script Loaded!", "Tác giả: Van Kiều", 3)

-- Hàm lấy chính xác thời gian còn lại của sét từ vật thể trong game
local function GetLightningDuration(lightningObj)
    if lightningObj:GetAttribute("Time") then
        return tonumber(lightningObj:GetAttribute("Time"))
    elseif lightningObj:GetAttribute("Duration") then
        return tonumber(lightningObj:GetAttribute("Duration"))
    end
    
    local timerLabel = lightningObj:FindFirstChildWhichIsA("TextLabel", true)
    if timerLabel then
        local timeText = string.match(timerLabel.Text, "%d+%.?%d*")
        if timeText then
            return tonumber(timeText)
        end
    end
    
    return 3.0
end

-- Hệ thống theo dõi Sét Đánh
local function MonitorLightning()
    workspace.ChildAdded:Connect(function(child)
        if not AutoCollectEnabled and not CountdownEnabled then return end
        
        local childName = string.lower(child.Name)
        if string.find(childName, "lightning") or string.find(childName, "strike") or string.find(childName, "warning") or child:FindFirstChild("LightningEffect") then
            
            local exactTime = GetLightningDuration(child)
            
            -- Chức năng 2: Bộ đếm ngược chuẩn từng giây (3 -> 2 -> 1)
            if CountdownEnabled then
                task.spawn(function()
                    local remaining = math.floor(exactTime)
                    for i = remaining, 1, -1 do
                        Notify("CẢNH BÁO SÉT!", "Sét đánh sau: " .. i .. " giây", 1)
                        task.wait(1)
                    end
                end)
            end
            
            -- Chức năng 1: Tự động lấy cây trước đúng 1 giây
            if AutoCollectEnabled then
                local timeToWait = math.max(0, exactTime - 1.0)
                
                task.delay(timeToWait, function()
                    local player = game.Players.LocalPlayer
                    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
                    
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if (string.find(string.lower(obj.Name), "tree") or string.find(string.lower(obj.Name), "crop") or obj:FindFirstChild("Harvest")) then
                            local pos = obj:IsA("BasePart") and obj.Position or (obj:FindFirstChild("HumanoidRootPart") and obj.HumanoidRootPart.Position)
                            
                            if pos and child:IsA("BasePart") and (pos - child.Position).Magnitude < 15 then
                                local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or child:FindFirstChildOfClass("ProximityPrompt")
                                if prompt then
                                    fireproximityprompt(prompt)
                                else
                                    player.Character.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                                end
                                
                                Notify("THÀNH CÔNG!", "Đã nhặt cây trước sét đánh đúng 1 giây!", 2)
                                break
                            end
                        end
                    end
                end)
            end
            
        end
    end)
end

